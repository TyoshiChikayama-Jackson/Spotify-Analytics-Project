# Spotify PKCE auth does not use a client secret, so the Client ID is not sensitive
# and is safe to commit to version control.
#
# This project keeps the actual values in src/config.js (top of the file) for easy
# editing rather than reading them from environment variables — edit that file directly:
#
#   SPOTIFY_CLIENT_ID = 'your-client-id-from-the-spotify-dashboard'
#   SPOTIFY_REDIRECT_URI = 'https://yourusername.github.io/your-repo/'
#
# The redirect URI must exactly match a Redirect URI registered for your app in the
# Spotify Developer Dashboard (https://developer.spotify.com/dashboard).
